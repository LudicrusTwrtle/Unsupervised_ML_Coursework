    "def label_data(data, model):\n",
    "    labels = model[\"Labels\"]\n",
    "    # Add cluster labels to the features DataFrame\n",
    "    df_labeled = data.copy()\n",
    "    df_labeled[\"Cluster\"] = labels\n",
    "    return df_labeled\n",
    "\n",
    "def plot_tsne(data_tsne, data_org, model):\n",
    "    for c in range(model[\"Clusters\"]):\n",
    "        selections = data_tsne[data_org['Cluster'] == c].values\n",
    "        plt.scatter(selections[:,0], selections[:,1], alpha=0.2, s=5)\n",
    "        x, y = selections.mean(axis=0)\n",
    "        plt.text(x, y, str(c), fontdict={'weight': 'bold', 'size': 30})\n",
    "    if model[\"Model\"].split()[0] == \"DBSCAN\":\n",
    "        selections = data_tsne[data_org['Cluster'] == -1].values\n",
    "        plt.scatter(selections[:,0], selections[:,1], alpha=0.2, s=5)\n",
    "        plt.text(x, y, str(-1), fontdict={'weight': 'bold', 'size': 30})\n",
    "\n",
    "low_dim_img = dict()\n",
    "j = 5\n",
    "for j in modeling_results:\n",
    "    for perp in range(5,55,15):\n",
    "        plt.figure(figsize=(24, 8))\n",
    "        col = 1\n",
    "        for iter in [250, 500, 1000]:\n",
    "            t_sne = TSNE(perplexity=perp,verbose=1,n_iter=iter, random_state=0)\n",
    "            img_labeled = label_data(pd.DataFrame(img_data),modeling_results[j])\n",
    "            low_dim_img[j,(perp,iter)] = pd.DataFrame(t_sne.fit_transform(img_data))\n",
    "            plt.suptitle(f'Low Dimensional Representation of Arabic Numerals (perplexity = {perp})')\n",
    "            plt.subplot(1,3,col)\n",
    "            plt.title(f\"t-SNE Iterations: {iter}\")\n",
    "            plot_tsne(low_dim_img[j,(perp,iter)], img_labeled, modeling_results[j])\n",
    "            col += 1\n",
    "        plt.show()"
   ]
  },
