    "for c in range(n_best):\n",
    "    counts = np.bincount(digit_check[best_labels == c], minlength=10)\n",
    "    cluster_to_digit[c] = counts.argmax()\n",
    "    print(f\"Cluster {c}: digit {counts.argmax()} ({counts.max() / counts.sum():.0%} of {counts.sum()} images)\")\n",
    "\n",
    "plt.figure(figsize=(18, 3))\n",
    "for c in range(n_best):\n",
    "    plt.subplot(1, n_best, c + 1)\n",
    "    plt.imshow(img_data[best_labels == c].mean(axis=0).reshape(28, 28).T, cmap='gray')\n",
    "    plt.title(f'Cluster {c}\\nDigit {cluster_to_digit[c]}')\n",
    "    plt.axis('off')\n",
    "plt.suptitle(f'Average Image of Each {BEST} Cluster')\n",
    "plt.show()"
